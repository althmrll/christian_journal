<% content_for :title, "Entries" %>

<div class="w-full">
  <div class="flex justify-between items-center mb-12">
    <h1 class="font-bold text-4xl">Entries</h1>
    <%= link_to "+ New entry", new_entry_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
  </div>

  <div id="entries" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @entries.any? %>
      <% @entries.each do |entry| %>
      <div class="flex">
        <div class="flex hover:bg-slate-50 g-white p-5 rounded-lg border border-gray-200 w-full shadow-sm justify-between items-center pb-5 mr-2 sm:pb-0">
        <h2 class="font-bold text-3xl mb-2"><%= link_to entry.title.camelize, entry %></h2>
        <div class="flex gap-1">
          <%= button_to entry_path(entry), method: :delete, title: "Delete Entry", class: "p-2 text-slate-800 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors bg-transparent border-0 cursor-pointer", data: { turbo_confirm: "Are you sure?" } do %>
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
          <% end %>
        </div>
        </div>
      </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">No entries found.</p>
    <% end %>
  </div>
</div>
