<% content_for :title, "Entries" %>

<div class="w-full">
  <div class="flex justify-between items-center mb-12">
    <h1 class="font-bold text-4xl">Entries</h1>
    <%= link_to "+ New entry", new_entry_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
  </div>

  <div id="entries" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @entries.any? %>
      <% @entries.each do |entry| %>
      <div class="flex">
        <div class="flex hover:bg-slate-50 bg-white p-5 rounded-lg border border-gray-200 w-full shadow-sm justify-between items-center">
          <h2 class="font-bold text-3xl"><%= link_to entry.title.camelize, entry %></h2>
          <%= button_to "Delete", entry_path(entry), method: :delete, form_class: "inline-flex items-center m-0", class: "px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-600 font-medium text-xs rounded-md transition-colors cursor-pointer" %>
        </div>
      </div>
      <% end %>
    <% else %>
      <p class="text-center my-10 text-gray-500">No entries found.</p>
    <% end %>
  </div>
</div>
