<% content_for :title, "Entries" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center mb-12">
    <h1 class="font-bold text-4xl">Entries</h1>
    <%= link_to "+ New entry", new_entry_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
  </div>

  <div id="entries" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @entries.any? %>
      <% @entries.each do |entry| %>
      <div class="flex">
        <div class="hover:bg-slate-50 g-white p-5 rounded-lg border border-gray-200 w-full shadow-sm justify-between items-center pb-5 mr-2 sm:pb-0">
        <h2 class="font-bold text-3xl mb-2"><%= link_to entry.title.camelize, entry %></h2>
        </div>
        <div class="flex items-center space-x-2">
            <%= link_to "Edit", edit_entry_path(entry), class: "rounded-md px-3.5 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 text-semibold transition-colors" %>
            <%= button_to "Destroy", entry, method: :delete, class: "rounded-md px-3.5 py-2 bg-red-600 hover:bg-red-500 text-white text-semibold transition-colors", data: { turbo_confirm: "Are you sure?" } %>
</div>
      </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">No entries found.</p>
    <% end %>
  </div>
</div>
