<% content_for :title, "Showing entry" %>
<div class="w-full mx-auto px-4 py-8 flex gap-8">
  <!-- Left Sidebar: Entry Index List -->
  <aside class="w-75 border-r border-gray-200 pr-6 shrink-0">
    <h2 class="text-xl font-bold text-slate-800 mb-4">All Entries</h2>
    <ul class="space-y-2">
      <% @entries.each do |e| %>
        <li>
          <%= link_to e.title, entry_path(e), 
                class: "block p-3 rounded-lg transition-colors #{'bg-slate-100 font-semibold text-slate-900' if e == @entry} #{'text-slate-600 hover:bg-gray-50' unless e == @entry}" %>
        </li>
      <% end %>
    </ul>
  </aside>

<div class="w-full mx-auto px-4 py-8">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>
  <div class="flex items-center justify-between mb-6">
  <%= link_to "<", entries_path, class: "w-full sm:w-auto text-grey-400 text-2xl font-semibold text-center mt-2 sm:mt-0 sm:ml-2 hover:text-gray-800 inline-block font-medium" %>
  <div>
  <%= link_to "Edit this entry", edit_entry_path(@entry), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= button_to "Destroy this entry", @entry, method: :delete, form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2", class: "w-full rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
  </div>
  </div>
  <%= render @entry %>
</div>
