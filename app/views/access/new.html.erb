<div class="max-w-md mx-auto my-12 p-8 border border-gray-200 rounded-lg shadow-sm bg-white">

  <% if flash[:alert] %>
    <p class="text-red-500 font-medium text-sm mb-4"><%= flash[:alert] %></p>
  <% end %>

  <%= form_with url: access_path, method: :post do |f| %>
    <div class="mb-5">
      <%= f.label :password, "Password", class: "block font-medium text-slate-700 mb-1" %>
      <%= f.password_field :password, 
            autofocus: true, 
            class: "w-full p-2.5 rounded-md border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all box-border" %>
    </div>

    <%= f.submit "Enter", class: "w-full rounded-md px-3.5 py-2.5 bg-slate-800 hover:bg-slate-700 text-white font-semibold transition-colors cursor-pointer" %>
  <% end %>
</div>