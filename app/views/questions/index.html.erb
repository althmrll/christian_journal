<% content_for :title, "Questions" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center mb-12">
    <h1 class="font-bold text-4xl">Questions</h1>
    <%= link_to "New Question", new_question_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
  </div>

  <div class="flex border-b border-slate-200 mb-8 gap-6">
    <%= link_to "Unanswered", questions_path(filter: "unanswered"), 
          class: "pb-3 text-base font-semibold border-b-2 #{params[:filter] == 'unanswered' || params[:filter].blank? ? 'border-blue-600 text-blue-600' : 'border-transparent text-slate-500 hover:text-slate-800'}" %>

    <%= link_to "Answered", questions_path(filter: "answered"), 
          class: "pb-3 text-base font-semibold border-b-2 #{params[:filter] == 'answered' ? 'border-blue-600 text-blue-600' : 'border-transparent text-slate-500 hover:text-slate-800'}" %>

    <%= link_to "All Questions", questions_path(filter: "all"), 
          class: "pb-3 text-base font-semibold border-b-2 #{params[:filter] == 'all' ? 'border-blue-600 text-blue-600' : 'border-transparent text-slate-500 hover:text-slate-800'}" %>
  </div>

  <div id="questions" class="min-w-full space-y-4">
    <% if @questions.any? %>
      <% @questions.each do |question| %>
        <% if question.answer.present? %>  
          <!-- ANSWERED QUESTION DRAWER -->
          <details class="group bg-white rounded-lg shadow-sm border border-slate-200 overflow-hidden">
            <summary class="flex justify-between items-center px-5 py-4 cursor-pointer font-semibold hover:bg-slate-50 transition-colors list-none select-none text-slate-400">
              <div class="flex items-center gap-2">
                <span class="mr-10 whitespace-pre-wrap text-xl font-bold"><%= question.question.camelize %></span>
                <svg class="h-5 w-5 text-slate-300 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
              <div class="flex gap-1">
                <%= link_to edit_question_path(question), title: "Update Answer", class: "p-2 text-slate-800 hover:text-slate-800 hover:bg-slate-300 rounded-lg transition-colors" do %>
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
                <% end %>

                <%= button_to question_path(question), method: :delete, title: "Delete Question", class: "p-2 text-slate-800 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors bg-transparent border-0 cursor-pointer" do %>
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
                <% end %>
              </div>
            </summary>
            
            <div class="whitespace-pre-wrap px-5 bg-slate-50 border-t border-slate-100 prose text-slate-600">
              <%= simple_format(question.answer) %>
            </div>
          </details>
        <% else %>
          <!-- UNANSWERED QUESTION CARD -->
          <div class="bg-white p-5 rounded-lg border border-slate-200 shadow-sm flex justify-between items-center">
            <h2 class="font-bold text-xl text-slate-800 whitespace-pre-wrap"><%= question.question.camelize %></h2>
            <div class="whitespace-nowrap">
            <%= link_to "Edit Question", edit_question_path(question, filter: params[:filter]), 
                  class: "ml-4 shrink-0 px-3 py-1.5 bg-gray-200 hover:bg-gray-500 text-black font-medium text-xs rounded-md shadow-sm transition-colors" %>

            <%= link_to "Answer Question", edit_question_path(question, filter: params[:filter]), 
                  class: "ml-4 shrink-0 px-3 py-1.5 bg-green-600 hover:bg-green-500 text-white font-medium text-xs rounded-md shadow-sm transition-colors" %>
            </div>
          </div>
        <% end %>
      <% end %>
    <% else %>
      <% if params[:filter] == "answered" %>
        <p class="text-center my-10 text-gray-500">No questions have been answered yet.</p>
      <% elsif params[:filter] == "unanswered" || params[:filter].blank? %>
        <p class="text-center my-10 text-gray-500">All questions have been answered!</p>
      <% else %>
        <p class="text-center my-10 text-gray-500">No questions yet.</p>
      <% end %>
    <% end %>
  </div>
</div>