<%= form_with(model: prayer, class: "contents") do |form| %>
  <% if prayer.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(prayer.errors.count, "error") %> prohibited this prayer from being saved:</h2>

      <ul class="list-disc ml-6">
        <% prayer.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :prayer %>
    <%= form.text_field :prayer, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": prayer.errors[:prayer].none?, "border-red-400 focus:outline-red-600": prayer.errors[:prayer].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :specification %>
    <%= form.textarea :specification, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": prayer.errors[:specification].none?, "border-red-400 focus:outline-red-600": prayer.errors[:specification].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
