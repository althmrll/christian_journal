<% content_for :title, "Prayers" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center mb-12">
    <h1 class="font-bold text-4xl">Prayers</h1>
    <%= link_to "New prayer", new_prayer_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
  </div>

  <div class="flex border-b border-slate-200 mb-8 gap-6">
    <%= link_to "Unanswered", prayers_path(filter: "unanswered"), 
          class: "pb-3 text-base font-semibold border-b-2 #{params[:filter] == 'unanswered' || params[:filter].blank? ? 'border-blue-600 text-blue-600' : 'border-transparent text-slate-500 hover:text-slate-800'}" %>

    <%= link_to "Answered", prayers_path(filter: "answered"), 
          class: "pb-3 text-base font-semibold border-b-2 #{params[:filter] == 'answered' ? 'border-blue-600 text-blue-600' : 'border-transparent text-slate-500 hover:text-slate-800'}" %>

    <%= link_to "All Prayers", prayers_path(filter: "all"), 
          class: "pb-3 text-base font-semibold border-b-2 #{params[:filter] == 'all' ? 'border-blue-600 text-blue-600' : 'border-transparent text-slate-500 hover:text-slate-800'}" %>
  </div>

  <div id="prayers" class="min-w-full space-y-4">
    <% if @prayers.any? %>
      <% @prayers.each do |prayer| %>
        <% if prayer.specification.present? %>  
          <details class="group bg-white rounded-lg shadow-sm border border-slate-200 overflow-hidden">
            <summary class="flex justify-between items-center px-5 py-4 cursor-pointer font-semibold text-slate-800 hover:bg-slate-50 transition-colors list-none select-none">
              <div class="flex items-center gap-2">
                <span class="text-xl font-bold"><%= prayer.prayer.camelize %></span>
                <svg class="h-5 w-5 text-slate-500 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
              
              <% if prayer.answered? %>
                <%= button_to "Delete", prayer_path(prayer) %>
              <% else %>
                <%= button_to "Mark as Answered", answered_prayer_path(prayer), 
                      method: :patch, 
                      class: "ml-4 shrink-0 px-3 py-1.5 bg-green-600 hover:bg-green-500 text-white font-medium text-xs rounded-md shadow-sm transition-colors" %>
              <% end %>
            </summary>
            <div class="px-5 py-4 bg-slate-50 border-t border-slate-100 text-slate-600 prose">
              <%= simple_format(prayer.specification) %>
            </div>
          </details>
        <% else %>
          <div class="bg-white p-5 rounded-lg border border-slate-200 shadow-sm flex justify-between items-center">
            <h2 class="font-bold text-xl"><%= prayer.prayer.camelize %></h2>
            <% if prayer.answered? %>
              <%= button_to "Delete", prayer_path(prayer) %>
            <% else %>
              <%= button_to "Mark as Answered", answered_prayer_path(prayer), 
                    method: :patch, 
                    class: "ml-4 shrink-0 px-3 py-1.5 bg-green-600 hover:bg-green-500 text-white font-medium text-xs rounded-md shadow-sm transition-colors" %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% else %>
      <p class="text-center my-10 text-gray-500">No prayers found.</p>
    <% end %>
  </div>
</div>